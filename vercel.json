{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/radar-equipe-compute",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/jessica-cabinet-emails",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/api/cron/jessica-cabinet-weekly",
      "schedule": "0 15 * * 5"
    },
    {
      "path": "/api/cron/crm-pipeline-weekly-recap",
      "schedule": "0 16 * * 5"
    },
    {
      "path": "/api/cron/livret-relances",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/expert-documents",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cfa-business-dev",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/business-signaux",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/cron/seo-score",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/seo-gsc",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/care-reminders",
      "schedule": "0 8 * * *"
    }
  ]
}


